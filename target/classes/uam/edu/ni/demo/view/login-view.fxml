<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="559.0" prefWidth="700.0" styleClass="fondo-principal" stylesheets="@../css/styles-login.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uam.edu.ni.demo.controller.LoginController">
    <children>
        <VBox alignment="CENTER_LEFT" layoutX="175.0" layoutY="75.0" prefHeight="350.0" prefWidth="350.0" spacing="15.0" styleClass="tarjeta-login">
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
            </padding>
            <children>

                <Label alignment="CENTER" prefWidth="350.0" styleClass="titulo" text="¡Bienvenido!" textAlignment="CENTER">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="20.0" />
                    </VBox.margin>
                </Label>

                <Label styleClass="etiqueta" text="Usuario:" />
                <TextField fx:id="txtUsuario" promptText="Ingrese su usuario" styleClass="campo-texto" />

                <Label styleClass="etiqueta" text="Contraseña:">
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </Label>
                <PasswordField fx:id="pswPassword" promptText="Ingrese su contraseña" styleClass="campo-texto" />

                <HBox alignment="CENTER" spacing="20.0">
                    <VBox.margin>
                        <Insets top="30.0" />
                    </VBox.margin>
                    <children>
                        <Button fx:id="btnSalir" cancelButton="true" mnemonicParsing="false" onAction="#accionSalir" prefWidth="120.0" styleClass="boton-secundario" text="Salir" />
                        <Button fx:id="btnIniciarSesion" defaultButton="true" mnemonicParsing="false" onAction="#accionIniciarSesion" prefWidth="120.0" styleClass="boton-primario" text="Iniciar Sesión" />
                    </children>
                </HBox>

            </children>
        </VBox>
    </children>
</AnchorPane>
