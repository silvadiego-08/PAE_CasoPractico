<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefWidth="500.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uam.edu.ni.demo.controller.RegistroController">
   
   <top>
      <VBox spacing="5.0" style="-fx-border-color: #cccccc; -fx-background-color: #ffc371; -fx-border-width: 0 0 1 0;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT">
               <children>
                  <Label alignment="CENTER" prefHeight="32.0" prefWidth="476.0" text="Registro de Cliente" textFill="WHITE" HBox.hgrow="ALWAYS">
                     <font>
                        <Font name="Elephant" size="32.0" />
                     </font>
                  </Label>
                  <StackPane HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
         </children>
      </VBox>
   </top>

   <center>
      <VBox prefWidth="508.0" spacing="15.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <children>
            <Label text="Información Personal">
               <font>
                  <Font name="Times New Roman Bold" size="17.0" />
               </font>
            </Label>

            <GridPane hgap="20.0" vgap="15.0">
               <columnConstraints>
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints vgrow="SOMETIMES" />
                  <RowConstraints vgrow="SOMETIMES" />
                  <RowConstraints vgrow="SOMETIMES" />
                  <RowConstraints vgrow="SOMETIMES" />
               </rowConstraints>
               <children>

                  <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                     <children>
                        <Label text="Nombres">
                           <font>
                              <Font name="Times New Roman Bold" size="13.0" />
                           </font></Label>
                        <TextField fx:id="txtNombres" prefHeight="11.0" prefWidth="226.0" promptText="Ingrese nombres" />
                     </children>
                  </VBox>
                  <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                     <children>
                        <Label text="Apellidos">
                           <font>
                              <Font name="Times New Roman Bold" size="13.0" />
                           </font></Label>
                        <TextField fx:id="txtApellidos" promptText="Ingrese apellidos" />
                     </children>
                  </VBox>

                  <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                     <children>
                        <Label text="Tipo de cliente">
                           <font>
                              <Font name="Times New Roman Bold" size="13.0" />
                           </font></Label>
                        <ComboBox fx:id="cbTipoCliente" maxWidth="1.1797693134862315E308" promptText="Seleccionar" />
                     </children>
                  </VBox>
                  <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                     <children>
                        <Label text="Ciudad">
                           <font>
                              <Font name="Times New Roman Bold" size="13.0" />
                           </font></Label>
                        <ComboBox fx:id="cbCiudad" maxWidth="1.1797693134862315E308" promptText="Seleccionar" />
                     </children>
                  </VBox>

                  <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
                     <children>
                        <Label text="Fecha de nacimiento">
                           <font>
                              <Font name="Times New Roman Bold" size="13.0" />
                           </font></Label>
                        <DatePicker fx:id="dpFechaNacimiento" maxWidth="1.1797693134862315E308" promptText="dd/mm/aaaa" />
                     </children>
                  </VBox>
                  <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                     <children>
                        <Label text="Tipo de solicitud">
                           <font>
                              <Font name="Times New Roman Bold" size="13.0" />
                           </font></Label>
                        <GridPane hgap="10.0" vgap="8.0">
                           <columnConstraints>
                              <ColumnConstraints hgrow="SOMETIMES" />
                              <ColumnConstraints hgrow="SOMETIMES" />
                           </columnConstraints>
                           <rowConstraints>
                              <RowConstraints vgrow="SOMETIMES" />
                              <RowConstraints vgrow="SOMETIMES" />
                           </rowConstraints>
                           <children>
                              <RadioButton fx:id="rbConsulta" mnemonicParsing="false" selected="true" text="Consulta" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                 <toggleGroup>
                                    <ToggleGroup fx:id="grupoSolicitud" />
                                 </toggleGroup>
                                 <font>
                                    <Font name="Times New Roman" size="13.0" />
                                 </font>
                              </RadioButton>
                              <RadioButton fx:id="rbContratacion" mnemonicParsing="false" text="Contratación" toggleGroup="$grupoSolicitud" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                 <font>
                                    <Font name="Times New Roman" size="13.0" />
                                 </font></RadioButton>
                              <RadioButton fx:id="rbSoporte" mnemonicParsing="false" text="Soporte" toggleGroup="$grupoSolicitud" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                 <font>
                                    <Font name="Times New Roman" size="13.0" />
                                 </font></RadioButton>
                              <RadioButton fx:id="rbReclamo" mnemonicParsing="false" text="Reclamo" toggleGroup="$grupoSolicitud" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                 <font>
                                    <Font name="Times New Roman" size="13.0" />
                                 </font></RadioButton>
                           </children>
                        </GridPane>
                     </children>
                  </VBox>

                  <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="3">
                     <children>
                        <Label text="Servicios de interés">
                           <font>
                              <Font name="Times New Roman Bold" size="13.0" />
                           </font>
                        </Label>
                        <VBox spacing="6.0">
                           <children>
                              <CheckBox fx:id="chkInternet" mnemonicParsing="false" text="Internet">
                                 <font>
                                    <Font name="Times New Roman" size="13.0" />
                                 </font></CheckBox>
                              <CheckBox fx:id="chkTelefonia" mnemonicParsing="false" text="Telefonía">
                                 <font>
                                    <Font name="Times New Roman" size="13.0" />
                                 </font></CheckBox>
                              <CheckBox fx:id="chkCable" mnemonicParsing="false" text="Cable">
                                 <font>
                                    <Font name="Times New Roman" size="13.0" />
                                 </font></CheckBox>
                              <CheckBox fx:id="chkSoporteTecnico" mnemonicParsing="false" text="Soporte técnico">
                                 <font>
                                    <Font name="Times New Roman" size="13.0" />
                                 </font></CheckBox>
                           </children>
                           <VBox.margin>
                              <Insets top="4.0" />
                           </VBox.margin>
                        </VBox>
                     </children>
                  </VBox>
                  <VBox alignment="TOP_CENTER" spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
                     <children>
                        <Label alignment="CENTER_LEFT" maxWidth="1.1797693134862315E308" text="Fotografía">
                           <font>
                              <Font name="Times New Roman Bold" size="12.0" />
                           </font>
                        </Label>
                        <StackPane fx:id="imgFotografia" prefHeight="90.0" prefWidth="120.0" style="-fx-border-color: #aaaaaa; -fx-border-style: dashed; -fx-background-color: #ffffff;">
                           <children>
                              <Label text="FOTO" textFill="#888888" />
                           </children>
                        </StackPane>
                        <Button mnemonicParsing="false" onAction="#handleSeleccionarFotografia" text="Seleccionar Fotografía">
                           <font>
                              <Font name="Times New Roman" size="13.0" />
                           </font></Button>
                     </children>
                  </VBox>

               </children>
            </GridPane>
         </children>
      </VBox>
   </center>

   <bottom>
      <HBox alignment="CENTER_RIGHT" prefHeight="53.0" prefWidth="500.0" spacing="10.0" style="-fx-border-color: #cccccc; -fx-border-width: 1 0 0 0;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <children>
            <Button mnemonicParsing="false" onAction="#handleLimpiar" text="Limpiar">
               <font>
                  <Font name="Times New Roman" size="13.0" />
               </font></Button>
            <Button mnemonicParsing="false" onAction="#handleCancelar" text="Cancelar">
               <font>
                  <Font name="Times New Roman" size="13.0" />
               </font></Button>
            <Button mnemonicParsing="false" onAction="#handleGuardar" style="-fx-font-weight: bold;" text="Guardar">
               <font>
                  <Font name="Times New Roman" size="13.0" />
               </font></Button>
         </children>
      </HBox>
   </bottom>

</BorderPane>
