<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="650.0" styleClass="root-pane" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uam.edu.ni.demo.controller.RegistroController">

   <top>
      <VBox styleClass="header-pane" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
         </padding>
         <children>
            <Label styleClass="header-title" text="Registro de Cliente" />
            <Label styleClass="header-subtitle" text="Complete los datos para generar una nueva solicitud" />
         </children>
      </VBox>
   </top>

   <center>
      <VBox spacing="20.0" styleClass="form-container" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="25.0" />
         </padding>
         <children>
            <Label styleClass="section-title" text="Información Personal y de Servicio" />

            <GridPane hgap="25.0" vgap="20.0">
               <columnConstraints>
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints vgrow="SOMETIMES" />
                  <RowConstraints vgrow="SOMETIMES" />
                  <RowConstraints vgrow="SOMETIMES" />
                  <RowConstraints vgrow="SOMETIMES" />
               </rowConstraints>
               <children>

                  <VBox spacing="8.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                     <children>
                        <Label styleClass="field-label" text="Nombres" />
                        <TextField fx:id="txtNombres" promptText="Ej. Juan Carlos" styleClass="input-field" />
                     </children>
                  </VBox>
                  <VBox spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                     <children>
                        <Label styleClass="field-label" text="Apellidos" />
                        <TextField fx:id="txtApellidos" promptText="Ej. Pérez García" styleClass="input-field" />
                     </children>
                  </VBox>

                  <VBox spacing="8.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                     <children>
                        <Label styleClass="field-label" text="Tipo de cliente" />
                        <ComboBox fx:id="cbTipoCliente" maxWidth="1.1797693134862315E308" promptText="Seleccione una opción" styleClass="input-field" />
                     </children>
                  </VBox>
                  <VBox spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                     <children>
                        <Label styleClass="field-label" text="Ciudad" />
                        <ComboBox fx:id="cbCiudad" maxWidth="1.1797693134862315E308" promptText="Seleccione una opción" styleClass="input-field" />
                     </children>
                  </VBox>

                  <VBox spacing="8.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
                     <children>
                        <Label styleClass="field-label" text="Fecha de nacimiento" />
                        <DatePicker fx:id="dpFechaNacimiento" maxWidth="1.1797693134862315E308" promptText="DD/MM/AAAA" styleClass="input-field" />
                     </children>
                  </VBox>
                  <VBox spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                     <children>
                        <Label styleClass="field-label" text="Tipo de solicitud" />
                        <GridPane hgap="15.0" vgap="12.0">
                           <columnConstraints>
                              <ColumnConstraints hgrow="SOMETIMES" />
                              <ColumnConstraints hgrow="SOMETIMES" />
                           </columnConstraints>
                           <rowConstraints>
                              <RowConstraints vgrow="SOMETIMES" />
                              <RowConstraints vgrow="SOMETIMES" />
                           </rowConstraints>
                           <children>
                              <RadioButton fx:id="rbConsulta" mnemonicParsing="false" selected="true" styleClass="radio-option" text="Consulta" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                 <toggleGroup>
                                    <ToggleGroup fx:id="grupoSolicitud" />
                                 </toggleGroup>
                              </RadioButton>
                              <RadioButton fx:id="rbContratacion" mnemonicParsing="false" styleClass="radio-option" text="Contratación" toggleGroup="$grupoSolicitud" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                              <RadioButton fx:id="rbSoporte" mnemonicParsing="false" styleClass="radio-option" text="Soporte" toggleGroup="$grupoSolicitud" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                              <RadioButton fx:id="rbReclamo" mnemonicParsing="false" styleClass="radio-option" text="Reclamo" toggleGroup="$grupoSolicitud" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                           </children>
                        </GridPane>
                     </children>
                  </VBox>

                  <VBox spacing="8.0" GridPane.columnIndex="0" GridPane.rowIndex="3">
                     <children>
                        <Label styleClass="field-label" text="Servicios de interés" />
                        <VBox spacing="10.0">
                           <children>
                              <CheckBox fx:id="chkInternet" mnemonicParsing="false" styleClass="check-option" text="Internet" />
                              <CheckBox fx:id="chkTelefonia" mnemonicParsing="false" styleClass="check-option" text="Telefonía" />
                              <CheckBox fx:id="chkCable" mnemonicParsing="false" styleClass="check-option" text="Cable" />
                              <CheckBox fx:id="chkSoporteTecnico" mnemonicParsing="false" styleClass="check-option" text="Soporte técnico" />
                           </children>
                           <VBox.margin>
                              <Insets top="5.0" />
                           </VBox.margin>
                        </VBox>
                     </children>
                  </VBox>
                  <VBox alignment="TOP_CENTER" spacing="12.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
                     <children>
                        <Label alignment="CENTER_LEFT" maxWidth="1.1797693134862315E308" styleClass="field-label" text="Fotografía del Cliente" />
                        <StackPane prefHeight="120.0" prefWidth="120.0" styleClass="photo-frame">
                           <children>
                              <Label styleClass="photo-placeholder" text="Subir foto" />
                              <ImageView fx:id="imgFotografia" fitHeight="110.0" fitWidth="110.0" pickOnBounds="true" preserveRatio="true" />
                           </children>
                        </StackPane>
                        <Button mnemonicParsing="false" onAction="#handleSeleccionarFotografia" styleClass="btn-outline" text="Seleccionar archivo..." />
                     </children>
                  </VBox>

               </children>
            </GridPane>
         </children>
      </VBox>
   </center>

   <bottom>
      <HBox alignment="CENTER_RIGHT" spacing="15.0" styleClass="footer-pane" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
         </padding>
         <children>
            <Button mnemonicParsing="false" onAction="#handleLimpiar" styleClass="btn-flat" text="Limpiar formulario" />
            <HBox HBox.hgrow="ALWAYS" />
            <Button fx:id="btnCancelar" mnemonicParsing="false" onAction="#handleCancelar" styleClass="btn-secondary" text="Regresar" />
            <Button mnemonicParsing="false" onAction="#handleGuardar" styleClass="btn-primary" text="Guardar Registro" />
         </children>
      </HBox>
   </bottom>
   <stylesheets>
      <URL value="@estilos-registro.css" />
      <URL value="@../css/styles-registro.css" />
   </stylesheets>

</BorderPane>
