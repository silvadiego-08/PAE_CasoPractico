<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="450.0" prefWidth="600.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uam.edu.ni.demo.controller.ConsultaClientes">

    <top>
        <VBox spacing="5.0" style="-fx-border-color: #cccccc; -fx-border-width: 0 0 1 0;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label alignment="CENTER" prefHeight="18.0" prefWidth="572.0" text="Consulta de Clientes" textFill="#4da3e8" HBox.hgrow="ALWAYS">
                            <font>
                                <Font name="Elephant" size="26.0" />
                            </font>
                        </Label>
                        <StackPane HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
                <Label text="Clientes registrados" textFill="#555555">
               <font>
                  <Font name="Times New Roman Bold" size="17.0" />
               </font></Label>
            </children>
        </VBox>
    </top>

    <center>
        <VBox spacing="15.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <children>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <TextField fx:id="txtBuscar" promptText="Buscar cliente..." HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#handleActualizar" text="Actualizar">
                     <font>
                        <Font name="Times New Roman Bold" size="13.0" />
                     </font></Button>
                    </children>
                </HBox>

                <TableView fx:id="tablaClientes" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colNombre" prefWidth="150.0" text="Nombre completo" />
                        <TableColumn fx:id="colTipo" prefWidth="75.0" text="Tipo" />
                        <TableColumn fx:id="colCiudad" prefWidth="100.0" text="Ciudad" />
                        <TableColumn fx:id="colNacimiento" prefWidth="100.0" text="Nacimiento" />
                        <TableColumn fx:id="colSolicitud" prefWidth="120.0" text="Solicitud" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <Label text="Doble clic sobre un cliente para ver sus detalles" textFill="#666666">
                    <font>
                        <Font name="Times New Roman" size="12.0" />
                    </font>
                </Label>

            </children>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10.0" style="-fx-border-color: #cccccc; -fx-border-width: 1 0 0 0;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <children>
                <Button fx:id="handleEditar" mnemonicParsing="false" onAction="#handleEditar" text="Editar">
               <font>
                  <Font name="Times New Roman" size="13.0" />
               </font></Button>
            <Button fx:id="handleNuevoCliente" mnemonicParsing="false" onAction="#handleNuevoCliente" text="Nuevo" />
                <Button mnemonicParsing="false" onAction="#handleCerrar" text="Regresar">
               <font>
                  <Font name="Times New Roman" size="13.0" />
               </font></Button>
            </children>
        </HBox>
    </bottom>

</BorderPane>
