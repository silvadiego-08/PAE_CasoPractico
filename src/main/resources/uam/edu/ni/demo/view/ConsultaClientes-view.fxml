<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="550.0" prefWidth="750.0" styleClass="root-pane" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uam.edu.ni.demo.controller.ConsultaClientes">

    <top>
        <VBox styleClass="header-pane" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
            </padding>
            <children>
                <Label styleClass="header-title" text="Consulta de Clientes" />
                <Label styleClass="header-subtitle" text="Gestione y busque la información de los clientes registrados" />
            </children>
        </VBox>
    </top>

    <center>
        <VBox spacing="15.0" styleClass="content-container" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="25.0" left="30.0" right="30.0" top="25.0" />
            </padding>
            <children>

                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <TextField fx:id="txtBuscar" promptText="🔍 Buscar por nombre, ciudad o tipo..." styleClass="search-field" HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#handleActualizar" styleClass="btn-outline" text="Actualizar Datos" />
                    </children>
                </HBox>

                <TableView fx:id="tablaClientes" styleClass="modern-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colNombre" prefWidth="180.0" text="Nombre Completo" />
                        <TableColumn fx:id="colTipo" prefWidth="100.0" text="Tipo Cliente" />
                        <TableColumn fx:id="colCiudad" prefWidth="120.0" text="Ciudad" />
                        <TableColumn fx:id="colNacimiento" prefWidth="100.0" text="Nacimiento" />
                        <TableColumn fx:id="colSolicitud" prefWidth="120.0" text="Tipo Solicitud" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <Label styleClass="helper-text" text="💡 Doble clic sobre una fila para ver los detalles completos del cliente" />

            </children>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="15.0" styleClass="footer-pane" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
            </padding>
            <children>
                <Button mnemonicParsing="false" onAction="#handleCerrar" styleClass="btn-secondary" text="Regresar" />
                <HBox HBox.hgrow="ALWAYS" />
                <Button fx:id="handleEditar" mnemonicParsing="false" onAction="#handleEditar" styleClass="btn-secondary" text="Editar Seleccionado" />
                <Button fx:id="handleNuevoCliente" mnemonicParsing="false" onAction="#handleNuevoCliente" styleClass="btn-primary" text="Nuevo Cliente" />
            </children>
        </HBox>
    </bottom>
   <stylesheets>
      <URL value="@styles-consulta.css" />
      <URL value="@../css/styles-consulta.css" />
   </stylesheets>

</BorderPane>
