<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefWidth="500.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">

   <!-- ENCABEZADO -->
   <top>
      <VBox spacing="5.0" style="-fx-border-color: #cccccc; -fx-border-width: 0 0 1 0;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT">
               <children>
                  <Label alignment="CENTER" prefHeight="32.0" prefWidth="476.0" text="Registro de Cliente" textFill="#4882c9" HBox.hgrow="ALWAYS">
                     <font>
                        <Font name="Elephant" size="25.0" />
                     </font>
                  </Label>
                  <StackPane HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
         </children>
      </VBox>
   </top>

   <!-- CUERPO PRINCIPAL (FORMULARIO) -->
   <center>
      <VBox spacing="15.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <children>
            <Label text="Información Personal">
               <font>
                  <Font name="Times New Roman Bold" size="15.0" />
               </font>
            </Label>

            <!-- GRID DE 2 COLUMNAS -->
            <GridPane hgap="20.0" vgap="15.0">
               <columnConstraints>
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints vgrow="SOMETIMES" />
                  <RowConstraints vgrow="SOMETIMES" />
                  <RowConstraints vgrow="SOMETIMES" />
                  <RowConstraints vgrow="SOMETIMES" />
               </rowConstraints>
               <children>

                  <!-- Fila 0: Nombres y Apellidos -->
                  <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                     <children>
                        <Label text="Nombres" />
                        <TextField promptText="Ingrese nombres" />
                     </children>
                  </VBox>
                  <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                     <children>
                        <Label text="Apellidos" />
                        <TextField promptText="Ingrese apellidos" />
                     </children>
                  </VBox>

                  <!-- Fila 1: Tipo de cliente y Ciudad -->
                  <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                     <children>
                        <Label text="Tipo de cliente" />
                        <ComboBox maxWidth="1.1797693134862315E308" promptText="Seleccionar" />
                     </children>
                  </VBox>
                  <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                     <children>
                        <Label text="Ciudad" />
                        <ComboBox maxWidth="1.1797693134862315E308" promptText="Seleccionar" />
                     </children>
                  </VBox>

                  <!-- Fila 2: Fecha de nacimiento y Tipo de solicitud -->
                  <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
                     <children>
                        <Label text="Fecha de nacimiento" />
                        <DatePicker maxWidth="1.1797693134862315E308" promptText="dd/mm/aaaa" />
                     </children>
                  </VBox>
                  <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                     <children>
                        <Label text="Tipo de solicitud" />
                        <GridPane hgap="10.0" vgap="8.0">
                           <columnConstraints>
                              <ColumnConstraints hgrow="SOMETIMES" />
                              <ColumnConstraints hgrow="SOMETIMES" />
                           </columnConstraints>
                           <rowConstraints>
                              <RowConstraints vgrow="SOMETIMES" />
                              <RowConstraints vgrow="SOMETIMES" />
                           </rowConstraints>
                           <children>
                              <RadioButton mnemonicParsing="false" selected="true" text="Consulta" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                 <toggleGroup>
                                    <ToggleGroup fx:id="grupoSolicitud" />
                                 </toggleGroup>
                              </RadioButton>
                              <RadioButton mnemonicParsing="false" text="Contratación" toggleGroup="$grupoSolicitud" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                              <RadioButton mnemonicParsing="false" text="Soporte" toggleGroup="$grupoSolicitud" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                              <RadioButton mnemonicParsing="false" text="Reclamo" toggleGroup="$grupoSolicitud" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                           </children>
                        </GridPane>
                     </children>
                  </VBox>

                  <!-- Fila 3: Servicios de interés y Fotografía -->
                  <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="3">
                     <children>
                        <Label text="SERVICIOS DE INTERÉS">
                           <font>
                              <Font name="System Bold" size="11.0" />
                           </font>
                        </Label>
                        <VBox spacing="6.0">
                           <children>
                              <CheckBox mnemonicParsing="false" text="Internet" />
                              <CheckBox mnemonicParsing="false" text="Telefonía" />
                              <CheckBox mnemonicParsing="false" text="Cable" />
                              <CheckBox mnemonicParsing="false" text="Soporte técnico" />
                           </children>
                           <VBox.margin>
                              <Insets top="4.0" />
                           </VBox.margin>
                        </VBox>
                     </children>
                  </VBox>
                  <VBox alignment="TOP_CENTER" spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
                     <children>
                        <Label alignment="CENTER_LEFT" maxWidth="1.1797693134862315E308" text="FOTOGRAFÍA">
                           <font>
                              <Font name="System Bold" size="11.0" />
                           </font>
                        </Label>
                        <StackPane prefHeight="90.0" prefWidth="120.0" style="-fx-border-color: #aaaaaa; -fx-border-style: dashed; -fx-background-color: #ffffff;">
                           <children>
                              <Label text="FOTO" textFill="#888888" />
                           </children>
                        </StackPane>
                        <Button mnemonicParsing="false" text="[ Seleccionar fotografía ]" />
                     </children>
                  </VBox>

               </children>
            </GridPane>
         </children>
      </VBox>
   </center>

   <!-- PIE DE PÁGINA (BOTONES DE ACCIÓN) -->
   <bottom>
      <HBox alignment="CENTER_RIGHT" spacing="10.0" style="-fx-border-color: #cccccc; -fx-border-width: 1 0 0 0;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <children>
            <Button mnemonicParsing="false" text="Limpiar" />
            <Button mnemonicParsing="false" text="Cancelar" />
            <Button mnemonicParsing="false" style="-fx-font-weight: bold;" text="Guardar" />
         </children>
      </HBox>
   </bottom>

</BorderPane>
